generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  PF
  PJ
}

enum TransactionType {
  CREDIT
  DEBIT
}

model Client {
  id               Int       @id @default(autoincrement())
  
  // Dados básicos
  name             String    @db.VarChar(255)
  type             ClientType
  email            String?   @db.VarChar(255)
  phone            String?   @db.VarChar(20)
  
  // Dados de endereço
  addressStreet    String?   @db.VarChar(255)
  addressNumber    String?   @db.VarChar(20)
  addressComplement String?   @db.VarChar(255)
  addressCity      String?   @db.VarChar(255)
  addressState     String?   @db.VarChar(2)
  addressZip       String?   @db.VarChar(10)
  
  // PF: CPF (único)
  cpf              String?   @unique @db.VarChar(14)
  
  // PF: Dados pessoais
  gender           String?   @db.VarChar(1)
  birthDate        DateTime?
  
  // PJ: CNPJ (único)
  cnpj             String?   @unique @db.VarChar(18)
  
  // PJ: Dados jurídicos
  legalName        String?   @db.VarChar(255)
  foundedDate      DateTime?
  
  // Movimentação inicial (saldo inicial)
  initialBalance   Decimal   @default(0) @db.Decimal(12, 2)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  active           Boolean   @default(true)

  accounts         Account[]

  @@map("clients")
}

model Account {
  id              Int              @id @default(autoincrement())
  clientId        Int
  bankCode        String           @db.VarChar(20)
  bankName        String           @db.VarChar(255)
  branch          String           @db.VarChar(20)
  accountNumber   String           @db.VarChar(50)
  accountType     String           @db.VarChar(50)
  initialBalance  Decimal          @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  active          Boolean          @default(true)

  client          Client           @relation(fields: [clientId], references: [id])
  transactions    Transaction[]

  @@unique([bankCode, accountNumber], name: "unique_bank_account")
  @@map("accounts")
}

model Transaction {
  id              Int              @id @default(autoincrement())
  accountId       Int
  type            TransactionType
  amount          Decimal          @db.Decimal(12, 2)
  description     String           @db.VarChar(255)
  transactionDate DateTime
  createdAt       DateTime         @default(now())

  account         Account          @relation(fields: [accountId], references: [id])

  @@map("transactions")
}
